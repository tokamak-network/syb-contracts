{
  "name": "newsybil-subgraph",
  "version": "1.0.0",
  "description": "Subgraph for the NewSybil smart contract on Sepolia",
  "license": "MIT",
  "scripts": {
    "codegen": "graph codegen",
    "build": "graph build",
    "deploy:goldsky": "goldsky subgraph deploy newsybil/1.0.0 --path .",
    "deploy:studio": "graph deploy --studio newsybil",
    "create:local": "graph create --node http://localhost:8020/ newsybil",
    "deploy:local": "graph deploy --node http://localhost:8020/ --ipfs http://localhost:5001 newsybil",
    "remove:local": "graph remove --node http://localhost:8020/ newsybil"
  },
  "devDependencies": {
    "@graphprotocol/graph-cli": "^0.71.0",
    "@graphprotocol/graph-ts": "^0.32.0"
  }
}

