# GENERAL CONFIGURATION

# Replace with your private key (without 0x prefix)R
PRIVATE_KEY=

# Replace with your RPC provider URL
PROVIDER_URL=

# NEWSYBIL CONTRACT CONFIGURATION

# NewSybil Deployment Parameters
STAKE_AMOUNT=10000000000000000    # Default: 0.01 ether (in wei)
WINDOW_TIME=240                   # Challenge window duration in seconds (default: 4 minutes)
BATCH_SIZE=100                    # Maximum edges per batch submission

# NewSybil Contract Address (after deployment)
NEWSYBIL_CONTRACT_ADDRESS=

# SYBIL CONTRACT CONFIGURATION

# Poseidon Hash Function Contract Addresses
POSEIDON1ELEMENTS=
POSEIDON2ELEMENTS=
POSEIDON3ELEMENTS=

# Verifier Contract Address
VERIFIER=

# Sybil Contract Address (after deployment)
SYBIL_CONTRACT_ADDRESS=

# MERKLE TREE & BATCH CONFIGURATION

# Maximum number of transactions per batch
MAXTX=100

# Number of levels in the Sparse Merkle Tree
NLEVEL=5
